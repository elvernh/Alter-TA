global
    log stdout format raw local0

defaults
    log global
    mode http
    option httplog
    option log-health-checks
    timeout connect {{TIMEOUT_MS}}ms
    timeout check {{TIMEOUT_MS}}ms
    timeout client 30s
    timeout server 30s

frontend api
    bind :8080
    default_backend services

backend services
    balance roundrobin
    option httpchk GET /health
    http-check expect status 200
    server service1 service1:3000 check inter {{INTER_MS}}ms fall {{FALL}} rise {{RISE}}
    server service2 service2:3000 check inter {{INTER_MS}}ms fall {{FALL}} rise {{RISE}}
    server service3 service3:3000 check inter {{INTER_MS}}ms fall {{FALL}} rise {{RISE}}

frontend statistics
    bind :8404
    stats enable
    stats uri /stats
    stats refresh 1s

